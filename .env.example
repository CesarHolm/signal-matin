# Copie ce fichier vers .env. Ne publie jamais le fichier .env reel.
# Les connecteurs de base (demo, RSS, meteo, ICS) n'ont besoin d'aucune cle.

# Chemins OAuth facultatifs pour Google Calendar.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Édition personnalisée : clé API Anthropic (console : platform.claude.com).
# Sans clé, le journal sort en mode secours (titres et chapôs bruts des flux).
ANTHROPIC_API_KEY=
